# Public address of the live site. Used for canonical URLs, the sitemap and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Leave all three empty to run in demo mode (local JSON data, no login).
# Project URL and keys: Supabase dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key. Only used by the scripts in /scripts (seeding, demo removal, creating the admin user). Never sent to the browser.
SUPABASE_SECRET_KEY=

# Emails allowed to use the admin console. The database also keeps its own admin list (admin_users), which npm run admin:create fills in.
ADMIN_EMAILS=chaidezjason@gmail.com

# Contact form email delivery through Resend. Leave empty to only store messages in the database (visible under Admin > Messages).
RESEND_API_KEY=
# Address that receives contact form messages. Kept separate from the admin login on purpose.
CONTACT_TO_EMAIL=luisjacinto1107@gmail.com
# Sender. Before a domain is verified in Resend this must be onboarding@resend.dev and messages can only go to the Resend account owner's address.
CONTACT_FROM_EMAIL=Jacinto Construction <onboarding@resend.dev>
